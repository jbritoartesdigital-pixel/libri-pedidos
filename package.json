{
  "name": "libri-pedidos",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "find src public/js -type f \\( -name \"*.js\" -o -name \"*.mjs\" \\) -print0 | xargs -0 -n1 node --check",
    "db:migrate:local": "wrangler d1 migrations apply libri-pedidos-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply libri-pedidos-db --remote"
  },
  "dependencies": {
    "@mmmike/web-push": "^1.3.0",
    "@simplewebauthn/server": "^14.0.3",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
