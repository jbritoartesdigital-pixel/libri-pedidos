{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "libri-pedidos",
  "main": "src/index.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },

  "vars": {
    "ENVIRONMENT": "production",
    "ADMIN_PASSKEY_ORIGIN": "https://pedidos.libriconvites.com.br",
    "ADMIN_PASSKEY_RP_ID": "pedidos.libriconvites.com.br",
    "VAPID_SUBJECT": "https://pedidos.libriconvites.com.br"
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/pedido",
      "/pedido/*",
      "/meu-pedido/*",
      "/admin-v2",
      "/admin-v2/"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "libri-pedidos-db",
      "database_id": "658c569d-60eb-4f59-8532-a321539dd073"
    }
  ],

  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "libri-pedidos-files"
    }
  ]
}

