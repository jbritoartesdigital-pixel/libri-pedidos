{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "libri-pedidos",
  "main": "src/index.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },

  "vars": {
    "ENVIRONMENT": "production",
    "LIBRI_V3_CHECKOUT_ENABLED": "true",
    "LIBRI_V3_ADMIN_PAYMENT_ENABLED": "true",
    "LIBRI_V3_SUPPLEMENT_PAYMENT_ENABLED": "true",
    "LIBRI_V3_BLACK_LIBRI_ENABLED": "true",
    "ADMIN_PASSKEY_ORIGIN": "https://pedidos.libriconvites.com.br",
    "ADMIN_PASSKEY_RP_ID": "pedidos.libriconvites.com.br",
    "VAPID_SUBJECT": "https://pedidos.libriconvites.com.br"
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/admin",
      "/admin/",
      "/admin.html",
      "/api/*",
      "/pedido",
      "/pedido/*",
      "/loja",
      "/loja/",
      "/pedido-v3",
      "/pedido-v3/",
      "/meu-pedido/*",
      "/admin-v2",
      "/admin-v2/",
      "/admin-v2.html",
      "/client-v2.html",
      "/client-v3.html"
    ]
  },

  "ratelimits": [
    {"name":"FUNNEL_RATE_LIMIT","namespace_id":"20261124043","simple":{"limit":120,"period":60}},
    {"name":"RECOVERY_RATE_LIMIT","namespace_id":"20261126001","simple":{"limit":8,"period":60}},
    {"name":"AUTH_RATE_LIMIT","namespace_id":"20261126002","simple":{"limit":20,"period":60}},
    {"name":"CHECKOUT_RATE_LIMIT","namespace_id":"20261126003","simple":{"limit":12,"period":60}},
    {"name":"QUOTE_RATE_LIMIT","namespace_id":"20261126004","simple":{"limit":90,"period":60}},
    {"name":"CUSTOMER_WRITE_RATE_LIMIT","namespace_id":"20261126005","simple":{"limit":120,"period":60}}
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "libri-pedidos-db",
      "database_id": "658c569d-60eb-4f59-8532-a321539dd073"
    }
  ],

  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "libri-pedidos-files"
    }
  ]
}

