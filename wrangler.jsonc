{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "libri-pedidos",
  "main": "src/index.js",
  "compatibility_date": "2026-08-18",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "libri-pedidos-db",
      "database_id": "658c569d-60eb-4f59-8532-a321539dd073"
    }
  ]
}
